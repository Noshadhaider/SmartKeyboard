<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#ECEDF0"
    android:paddingLeft="3dp"
    android:paddingRight="3dp"
    android:paddingTop="6dp"
    android:paddingBottom="4dp">

    <com.smartkeyboard.app.CustomKeyboardView
        android:id="@+id/keyboard_view_letters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:keyBackground="@drawable/key_background" />

    <com.smartkeyboard.app.CustomKeyboardView
        android:id="@+id/keyboard_view_symbols"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:keyBackground="@drawable/key_background" />

    <LinearLayout
        android:id="@+id/emoji_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="6dp">

        <Button
            android:id="@+id/emoji_back_btn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="← ABC"
            android:textColor="#1C1C1E"
            android:background="@drawable/key_background"
            android:textAllCaps="false"
            android:layout_marginBottom="6dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <LinearLayout
                android:id="@+id/emoji_categories_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

    </LinearLayout>

</FrameLayout>
